    <application android:theme="@style/AppTheme" android:label="K3 AI Screening ULP Empang" android:usesCleartextTraffic="false" android:hardwareAccelerated="true">
        <activity android:name=".MainActivity" android:screenOrientation="portrait" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
